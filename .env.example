# ==============================================================================
# App Wallet Environment Variables
# ==============================================================================
# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Database Connection (Optional direct DB access)
DATABASE_URL="postgresql://postgres:your-password@your-host:5432/postgres?sslmode=require"

# GitHub OAuth Integration (Optional)
EXPO_PUBLIC_GITHUB_CLIENT_ID="your-github-client-id"
